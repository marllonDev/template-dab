# databricks.yml
# Configuração principal do bundle: {{.project_name}}
# Gerado pelo template corporativo DAB

bundle:
  name: {{.project_name}}

include:
  - resources/*.yml

variables:
  catalog:
    description: "Catálogo Unity Catalog ativo para o target atual"
  schema:
    description: "Schema Unity Catalog ativo para o target atual"
    default: {{.schema_name}}

targets:
  # ──────────────────────────────────────────────
  # Ambiente de Desenvolvimento
  # ──────────────────────────────────────────────
  dev:
    mode: development
    default: true
    variables:
      catalog: {{.catalog_dev}}
    # O workspace host será resolvido automaticamente pela variável de ambiente
    # DATABRICKS_HOST configurada no CI/CD ou pelo profile local ativo.
    tags: &default_tags
      system: {{.system}}
      environment: dev
      department: {{.department}}
      stakeholders: {{.stakeholders}}
      managed_by: dab

  # ──────────────────────────────────────────────
  # Ambiente de Produção
  # ──────────────────────────────────────────────
  prod:
    mode: production
    variables:
      catalog: {{.catalog_prod}}
    workspace:
      root_path: /Shared/.bundle/prod/${bundle.name}
    tags:
      <<: *default_tags
      environment: prod
    run_as:
      # Em produção, os jobs devem rodar sob um Service Principal.
      # Configure o service_principal_name no GitHub Environment de PROD.
      service_principal_name: ${var.service_principal_name}
